{
  "name": "@js-joda/root",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/extra",
    "packages/locale",
    "packages/timezone"
  ],
  "description": "a date and time library for javascript",
  "repository": {
    "type": "git",
    "url": "https://github.com/js-joda/js-joda.git"
  },
  "author": "pithu",
  "contributors": [
    "pithu",
    "phueper"
  ],
  "homepage": "https://js-joda.github.io/js-joda",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/js-joda/js-joda/issues"
  },
  "scripts": {
    "postpublish": "npm run build-docs && ./shared/git-push-docs-on-change.sh",
    "build-docs": "tsx tools/src/commands/docs.ts",
    "build-esdoc": "npm run build-docs",
    "build-test-coverage-report": "./shared/build-test-coverage-report.sh",
    "build:dist": "npm run build-dist --workspaces --if-present",
    "build:locale": "npm run build-locale-dist --workspaces --if-present",
    "lint": "eslint tools/src && npm run lint --workspaces --if-present",
    "test:definitions": "npm run test-ts-definitions --workspaces --if-present",
    "test:coverage": "rm -rf .c8_output && npm run test-coverage --workspaces --if-present",
    "test:browser": "npm run test-browser --workspaces --if-present -- --browserNoActivityTimeout 20000",
    "audit:source": "tsx tools/src/commands/inventory.ts",
    "audit:deps": "tsx tools/src/commands/deps.ts",
    "api:capture": "tsx tools/src/commands/api-capture.ts",
    "api:lock": "tsx tools/src/commands/api-lock.ts",
    "check:api": "tsx tools/src/commands/api-check.ts",
    "check:no-js": "tsx tools/src/commands/no-js.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check:refactor": "npm run typecheck:tools && npm run check:api"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.4",
      "serialize-javascript": "7.0.7"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-virtual": "^3.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "c8": "12.0.0",
    "chai": "^4.5.0",
    "cldr-core": "36.0.0",
    "cldr-dates-full": "36.0.0",
    "cldr-numbers-full": "36.0.0",
    "cldrjs": "^0.5.5",
    "ejs": "^3.1.10",
    "eslint": "^10.0.1",
    "globals": "^16.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-rollup-preprocessor": "^7.0.8",
    "karma-sourcemap-loader": "^0.4.0",
    "mocha": "^11.7.5",
    "moment-timezone": "^0.6.1",
    "npm-check-updates": "^19.6.6",
    "ramda": "^0.32.0",
    "rollup": "^3.30.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typedoc": "0.28.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "yargs": "^17.7.2",
    "@types/node": "^18.11.17"
  }
}

{
  "name": "@js-joda/root",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "Strict TypeScript monorepo for js-joda",
  "packageManager": "npm@11",
  "workspaces": [
    "packages/core",
    "packages/extra",
    "packages/locale",
    "packages/timezone",
    "packages/locales/*"
  ],
  "scripts": {
    "clean": "node .build/tools/clean.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "build:tools": "tsc -p tsconfig.tools.json",
    "build": "npm run build:tools && node .build/tools/build.js",
    "build:ts-node": "ts-node --project tsconfig.ts-node.json src/tools/build.ts",
    "build:bun": "bun src/tools/build.ts",
    "check": "npm run typecheck && npm run build && node .build/tools/check.js && npm run build:ts-node",
    "check:repo": "npm run build:tools && node .build/tools/check.js --repo-only",
    "audit": "npm audit --audit-level=low",
    "pack:all": "npm run build && npm pack --workspaces --if-present"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.0.0",
    "cldr-core": "36.0.0",
    "cldr-dates-full": "36.0.0",
    "cldr-numbers-full": "36.0.0",
    "cldrjs": "^0.5.5",
    "rollup": "^4.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitty-crow/ts-joda.git"
  }
}
